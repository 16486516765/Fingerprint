<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".FingerprintApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="Fingerprint"
        android:theme="@style/Theme.Fingerprint"
        android:usesCleartextTraffic="false">
        <!-- 主进程：Profile 列表 / 设置页 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 浏览器进程 :wv0（slot 0 的本体声明） -->
        <activity
            android:name=".ui.BrowserActivity"
            android:exported="false"
            android:process=":wv0"
            android:taskAffinity="com.limao.fingerprint.wv0"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 浏览器进程 :wv1 ~ :wv5（通过 alias 复用同一个 BrowserActivity 类） -->
        <activity
            android:name=".ui.BrowserActivity1"
            android:exported="false"
            android:process=":wv1"
            android:taskAffinity="com.limao.fingerprint.wv1"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ui.BrowserActivity2"
            android:exported="false"
            android:process=":wv2"
            android:taskAffinity="com.limao.fingerprint.wv2"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ui.BrowserActivity3"
            android:exported="false"
            android:process=":wv3"
            android:taskAffinity="com.limao.fingerprint.wv3"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ui.BrowserActivity4"
            android:exported="false"
            android:process=":wv4"
            android:taskAffinity="com.limao.fingerprint.wv4"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ui.BrowserActivity5"
            android:exported="false"
            android:process=":wv5"
            android:taskAffinity="com.limao.fingerprint.wv5"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
